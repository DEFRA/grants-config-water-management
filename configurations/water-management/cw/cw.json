{
  "code": "water-management",
  "schemeName": "Water Management grant round 3 (WMG R3)",
  "requiredRoles": {
    "allOf": ["ROLE_WMG"],
    "anyOf": []
  },
  "templates": {},
  "definitions": {},
  "endpoints": [],
  "externalActions": [],
  "pages": {
    "cases": {
      "details": {
        "banner": {
          "title": {
            "text": "$.payload.answers.applicant.business.name",
            "type": "string"
          },
          "summary": {
            "scheme": {
              "label": "Scheme",
              "text": "$.schemeName",
              "type": "string"
            },
            "applicationId": {
              "label": "Application ID",
              "text": "$.caseRef",
              "type": "string"
            },
            "sbi": {
              "label": "SBI",
              "text": "$.payload.identifiers.sbi",
              "type": "string"
            },
            "status": {
              "label": "Status",
              "text": "$.currentStatusName",
              "type": "string"
            }
          }
        },
        "tabs": {}
      }
    }
  },
  "phases": [
    {
      "code": "PHASE_PRE_AWARD",
      "name": "Pre-award",
      "stages": [
        {
          "code": "STAGE_REVIEW_APPLICATION",
          "name": "Tasks",
          "description": "Review the application for sorting and ranking",
          "statuses": [
            {
              "code": "STATUS_APPLICATION_RECEIVED",
              "name": "Application Received",
              "theme": "NEUTRAL",
              "description": "Application received and pending ranking",
              "interactive": false,
              "closes": false,
              "transitions": [
                {
                  "targetPosition": "PHASE_PRE_AWARD:STAGE_REVIEW_APPLICATION:STATUS_APPLICATION_WITHDRAWAL_REQUESTED",
                  "checkTasks": false,
                  "action": {
                    "code": "WITHDRAW_APPLICATION",
                    "name": "Withdraw",
                    "checkTasks": false,
                    "comment": {
                      "label": "Explain this decision",
                      "helpText": "You must include an explanation for auditing purposes.",
                      "mandatory": true
                    }
                  }
                }
              ]
            },
            {
              "name": "Withdrawal requested",
              "code": "STATUS_APPLICATION_WITHDRAWAL_REQUESTED",
              "theme": "WARN",
              "description": "Application withdrawal has been requested and is awaiting withdrawal confirmation",
              "interactive": false,
              "closes": false,
              "transitions": [
                {
                  "targetPosition": "PHASE_PRE_AWARD:STAGE_REVIEW_APPLICATION:STATUS_APPLICATION_WITHDRAWN",
                  "checkTasks": false,
                  "action": null
                }
              ]
            },
            {
              "name": "Withdrawn",
              "code": "STATUS_APPLICATION_WITHDRAWN",
              "theme": "WARN",
              "description": "Application has been withdrawn",
              "interactive": false,
              "hideTaskGroups": true,
              "closes": true,
              "transitions": []
            }
          ],
          "taskGroups": [],
          "beforeContent": [
            {
              "renderIf": "jsonata:$.position.statusCode = 'STATUS_APPLICATION_RECEIVED'",
              "content": [
                {
                  "component": "heading",
                  "level": 3,
                  "text": "Withdrawing the application"
                },
                {
                  "component": "paragraph",
                  "text": "The application can be withdrawn at any time."
                },
                {
                  "component": "paragraph",
                  "text": "You might need to withdraw it if the customer:"
                },
                {
                  "component": "unordered-list",
                  "items": [
                    {
                      "component": "text",
                      "text": "needs to update their application"
                    },
                    {
                      "component": "text",
                      "text": "there is an error in the application"
                    }
                  ]
                }
              ]
            },
            {
              "renderIf": "jsonata:$.position.statusCode = 'STATUS_APPLICATION_WITHDRAWAL_REQUESTED'",
              "content": [
                {
                  "component": "heading",
                  "level": 3,
                  "text": "Withdrawal requested"
                },
                {
                  "component": "paragraph",
                  "text": "The application is being withdrawn. Refresh the page to check whether withdrawal has completed."
                },
                {
                  "component": "url",
                  "text": "Refresh page",
                  "href": {
                    "urlTemplate": "/cases/{caseId}",
                    "params": {
                      "caseId": "$._id"
                    }
                  },
                  "classes": "govuk-button"
                }
              ]
            },
            {
              "renderIf": "jsonata:$.position.statusCode = 'STATUS_APPLICATION_WITHDRAWN'",
              "content": [
                {
                  "component": "heading",
                  "level": 3,
                  "text": "Application withdrawn"
                },
                {
                  "component": "paragraph",
                  "text": "The application has been withdrawn."
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "version": "0.0.0"
}
